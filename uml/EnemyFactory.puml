@startuml
'https://plantuml.com/class-diagram

interface EnemyFactory{
    + createEnemyAircraft():AbstractEnemyAircraft
}

class EliteFactory{
    + createEnemyAircraft():AbstractEnemyAircraft
}
class MobFactory{
    + createEnemyAircraft():AbstractEnemyAircraft
}
EnemyFactory <|.. EliteFactory
EnemyFactory <|.. MobFactory


abstract AbstractEnemyAircraft{
    # score: int
    # propNum: int
    # propFactory: PropFactory
    + getScore():int
    + AbstractEnemyAircraft(int locationX, int locationY, int speedX, int speedY, int hp, int score)
    + {abstract} generateNewProp():List<BaseProp>
}

class MobEnemy {
    + MobEnemy(int locationX, int locationY, int speedX, int speedY, int hp, int score)
    + forward():void
    + shoot():List<BaseBullet>
    + generateNewProp():List<BaseProp>
}

class EliteEnemy {
    + EliteEnemy(int locationX, int locationY, int speedX, int speedY, int hp, int score)
    + forward():void
    + generateNewProp():List<BaseProp>
    + shoot():List<BaseBullet>
}

AbstractEnemyAircraft <.. EnemyFactory

AbstractEnemyAircraft <|-- EliteEnemy
AbstractEnemyAircraft <|-- MobEnemy

@enduml